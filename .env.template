# ============================================================
# Model configuration. Copy this file to .env and fill it in.
# Never commit .env (it is listed in .gitignore).
# ============================================================
# PROVIDER:  openai  = any OpenAI-compatible API (DeepSeek / Qwen / OpenRouter / local Ollama / vLLM)
#            gemini  = Google Gemini (google-genai SDK; pip install google-genai)
PROVIDER=openai
MODEL=deepseek-flash
API_KEY=
BASE_URL=https://api.deepseek.com

# Thinking mode:
#   DeepSeek: use "disabled". DeepSeek enables thinking by default; with thinking on,
#             temperature is ignored and thinking tokens can exhaust max_tokens,
#             truncating the output. These experiments require thinking to be off.
#   Gemini:   low / medium / high. Leave empty for models that do not support it.
THINKING_LEVEL=disabled

# Price per 1M tokens (USD), used only for cost accounting. If empty, the price
# table in pool/llm.py is used. Check your provider's current pricing.
PRICE_IN=0.28
PRICE_OUT=0.42

# Maximum number of concurrent API requests (lower it if you hit 429 rate limits).
MAX_CONCURRENCY=16

# Optional: extra JSON merged into every OpenAI-compatible request body.
# EXTRA_BODY={"provider": {"order": ["some-provider"]}}

# ---- Other examples ----
# Gemini:  PROVIDER=gemini  MODEL=gemini-3.1-flash-lite-preview  THINKING_LEVEL=low  API_KEY=AIza...
# Ollama:  PROVIDER=openai  MODEL=qwen2.5-coder:7b  BASE_URL=http://localhost:11434/v1  API_KEY=ollama
# Qwen:    PROVIDER=openai  MODEL=qwen-plus  BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
